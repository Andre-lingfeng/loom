# 统一换行符：脚本必须是 LF，否则 Linux 上会报 $'\r': command not found
* text=auto eol=lf

*.sh text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary

# 打包产物（体积大，不入库）
release/

# PDF 不入源码包（在作品文档目录里单独提供）
docs/report/*.pdf export-ignore
docs/report/*.png export-ignore
docs/screenshots/ export-ignore
