# 把 loom.example.com 换成你的域名（或删掉域名用 :80）
loom.example.com {
	encode zstd gzip

	# Next.js 的静态资源带哈希，可以长期缓存
	@static path /_next/static/*
	header @static Cache-Control public, max-age=31536000, immutable

	reverse_proxy 127.0.0.1:3000 {
		# 云端分析可能跑 20s 以上，读超时要放宽
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}
}
