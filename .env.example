# ---------------------------------------------------------------
# 服务端环境变量（部署时填）。这些只在服务端使用，不会打包进前端。
# 本地开发不需要——在 /kb/settings 里填自己的 Key 即可（只存浏览器）。
# ---------------------------------------------------------------

# 必填：任一 OpenAI 兼容端点的 Key
# 云端关系判定、问答综述、冲突分析都会用它（当访客没自带 Key 时）
DEEPSEEK_API_KEY=

# 可选：端点与模型
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可选：视觉模型（图片入库用）；留空则回落上面的 Key 与地址
# 主模型本身能看图时，这三项都不用填
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# 可选：额度限制
# 每 IP / 全站每天的模型调用次数
# 共享 Key 每天可消耗的 token 总量（用尽后提示用户自行配置 Key）
DEMO_TOKEN_BUDGET=300000

# 每 IP / 全站每天的模型调用次数（防刷，与 token 预算叠加）
DEMO_QUOTA_PER_IP=20
DEMO_QUOTA_GLOBAL=300

# 每 IP / 全站每天的网页抓取与 PDF 解析次数
FETCH_PER_IP_PER_DAY=60
FETCH_GLOBAL_PER_DAY=600
